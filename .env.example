# Public browser configuration. Use the URL and publishable/anon key from Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_DEMO_MODE=false
VITE_COMPANY_NAME=GearLane Auto Parts

# Vercel SERVER environment only. Never prefix this variable with VITE_.
# Required for admin-created/invited auth users; other workflows use RLS/RPC.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Set the public production URL for password recovery/invitation redirects.
SITE_URL=http://localhost:5173

# Email through Resend (Vercel SERVER environment only). See docs/OPERATIONS.md.
RESEND_API_KEY=
# Without a verified domain Resend only delivers to your own account address, using its onboarding sender:
EMAIL_FROM=GearLane <onboarding@resend.dev>
# The store owner's inbox for "a customer wrote to the seller" alerts. Use the email of your Resend account.
STAFF_ALERT_EMAIL=
# Emails to CUSTOMERS (order placed, shipped, ...). Leave unset until you have verified a domain in Resend.
EMAIL_CUSTOMERS=false
