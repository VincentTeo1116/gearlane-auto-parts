# Public browser configuration. Use the URL and publishable/anon key from Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_DEMO_MODE=false
VITE_COMPANY_NAME=GearLane Auto Parts

# Vercel SERVER environment only. Never prefix this variable with VITE_.
# Required for admin-created/invited auth users; other workflows use RLS/RPC.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Set the public production URL for password recovery/invitation redirects.
SITE_URL=http://localhost:5173
